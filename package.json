{
  "name": "websites-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous factory: discover local businesses -> evidence package -> personalized demo site -> approval-gated outreach",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "factory": "tsx src/cli.ts",
    "workers": "tsx src/workers/main.ts",
    "api": "tsx src/api/server.ts",
    "telegram": "tsx src/telegram/bot.ts",
    "all": "tsx src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@anthropic-ai/sdk": "^0.65.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/node-server": "^1.13.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.0",
    "grammy": "^1.30.0",
    "hono": "^4.6.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.0",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "playwright": "^1.49.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
