# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://factory:factory@localhost:5432/factory
POSTGRES_PASSWORD=factory

# Storage driver: s3 (MinIO/R2) or fs (local ./storage dir, zero-dependency mode)
STORAGE_MODE=s3
STORAGE_DIR=storage

# S3-compatible object storage (MinIO from docker-compose by default; R2 works too)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=factory
S3_SECRET_KEY=factorysecret
S3_BUCKET_RAW=factory-raw
S3_BUCKET_ASSETS=factory-assets

# ─── AI agents (REQUIRED for enrichment/content/builder/QA agents) ──────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5
AGENT_MODEL_HEAVY=claude-opus-4-5
# claude-code: builder = справжній Claude Code агент з workspace (Agent SDK),
#              збирає Next.js сайт, сам ганяє pnpm build і фіксить помилки.
# api:         дешевий fallback, одношотна генерація static HTML.
AGENT_RUNTIME=claude-code

# ─── Telegram approvals & alerts (REQUIRED before outreach works) ───────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Outreach: email (REQUIRED for email channel) ───────────────────────────
# Use a SEPARATE domain from your main one (deliverability protection).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Roman <roman@yourofferdomain.com>"
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ─── Outreach: WhatsApp Cloud API (optional; without it -> manual wa.me card)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── Demo deployment ─────────────────────────────────────────────────────────
# static  = factory serves exported sites itself on DEMO_BASE_URL (default)
# dokploy = push to a Dokploy instance via its API
DEPLOY_MODE=static
DEMO_BASE_URL=http://localhost:8788
DOKPLOY_URL=
DOKPLOY_TOKEN=

# ─── Behavior ────────────────────────────────────────────────────────────────
# dry_run: full pipeline runs but outreach send is simulated
FACTORY_MODE=dry_run
DASHBOARD_PORT=8787
DEMO_PORT=8788
MAX_QA_ITERATIONS=3
FOLLOWUP_SCHEDULE_DAYS=3,7
OUTREACH_DAILY_LIMIT=20
